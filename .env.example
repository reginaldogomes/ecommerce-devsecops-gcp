# ==============================================================================
# Configurações da Aplicação (carregadas por app/core/config.py via .env)
# Copie este arquivo para ".env" para uso local: cp .env.example .env
# ==============================================================================

# Nome exibido na documentação OpenAPI (/docs) e metadados da API
APP_NAME="E-Commerce DevSecOps GCP API"

# Versão semântica da aplicação
APP_VERSION="1.1.0"

# Ambiente de execução: development | staging | production
ENVIRONMENT="development"

# Nível de log estruturado (JSON): DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# ==============================================================================
# Variáveis de Deploy / CI/CD no GitHub Actions (Environment: production)
# Obs.: Este projeto usa Workload Identity Federation (OIDC) no GCP, portanto
# não utiliza chaves JSON estáticas nem secrets de credenciais no .env local.
# Configure os valores abaixo em:
# GitHub > Settings > Secrets and variables > Actions > Variables
# ==============================================================================

# ID do projeto no Google Cloud Platform
# GCP_PROJECT_ID="meu-projeto-gcp"

# Região do Artifact Registry e Cloud Run (padrão: southamerica-east1)
# GCP_REGION="southamerica-east1"

# Output "workload_identity_provider" gerado pelo Terraform (infra/outputs.tf)
# WIF_PROVIDER="projects/123456789012/locations/global/workloadIdentityPools/github-pool/providers/github-provider"

# Output "deployer_service_account" gerado pelo Terraform
# DEPLOYER_SA="github-deployer@meu-projeto-gcp.iam.gserviceaccount.com"

# Output "runtime_service_account" gerado pelo Terraform
# RUNTIME_SA="cloudrun-runtime@meu-projeto-gcp.iam.gserviceaccount.com"
